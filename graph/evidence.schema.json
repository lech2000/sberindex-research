{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrigate.pro/schemas/sberindex-municipality-evidence-v1.json",
  "title": "SberIndex municipality graph evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_key",
    "topic",
    "source_url",
    "checked_at",
    "status",
    "entities",
    "relations",
    "claims",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_key": {"type": "string", "minLength": 8, "maxLength": 160},
    "topic": {"type": "string", "minLength": 5, "maxLength": 500},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "checked_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["verified", "proposed", "blocked"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "entities": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/entity"}
    },
    "relations": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/relation"}
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "observed",
        "source_estimate",
        "model_estimate",
        "synthetic_assumption"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type", "label", "provenance_class"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 3, "maxLength": 180},
        "entity_type": {
          "enum": [
            "municipality",
            "organization",
            "dataset",
            "indicator",
            "event",
            "source",
            "synthetic_actor"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "provenance_class": {"$ref": "#/$defs/provenance"},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "source_ref": {"type": "string", "maxLength": 500}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_entity_id",
        "target_entity_id",
        "relation_type",
        "provenance_class",
        "confidence",
        "evidence_url"
      ],
      "properties": {
        "source_entity_id": {"type": "string", "minLength": 3, "maxLength": 180},
        "target_entity_id": {"type": "string", "minLength": 3, "maxLength": 180},
        "relation_type": {"type": "string", "minLength": 2, "maxLength": 100},
        "provenance_class": {"$ref": "#/$defs/provenance"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_url", "provenance_class", "confidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 3, "maxLength": 2000},
        "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "provenance_class": {"$ref": "#/$defs/provenance"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
