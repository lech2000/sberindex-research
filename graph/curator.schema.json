{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrigate.pro/schemas/sberindex-research-curator-v1.json",
  "title": "SberIndex research curator decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_key", "verdict", "applies_to", "plan_refs",
    "accepted_claim_indexes", "rejected_claim_indexes", "gaps",
    "next_action", "next_topic", "reviewed_at", "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_key": {"type": "string", "minLength": 8, "maxLength": 160},
    "verdict": {"enum": ["accept", "rework", "blocked"]},
    "applies_to": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["graph", "atlas", "radar"]}
    },
    "plan_refs": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "accepted_claim_indexes": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "rejected_claim_indexes": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "gaps": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["statement", "severity", "required_evidence"],
        "properties": {
          "statement": {"type": "string", "minLength": 3, "maxLength": 1000},
          "severity": {"enum": ["low", "medium", "high", "blocking"]},
          "required_evidence": {"type": "string", "minLength": 3, "maxLength": 1000}
        }
      }
    },
    "next_action": {"type": "string", "minLength": 5, "maxLength": 1000},
    "next_topic": {"type": "string", "minLength": 5, "maxLength": 500},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
